diff --git a/src/backend/storage/aio/aio.c b/src/backend/storage/aio/aio.c
index e64afe6..d0038b4 100644
--- a/src/backend/storage/aio/aio.c
+++ b/src/backend/storage/aio/aio.c
@@ -479,6 +479,62 @@ pgaio_io_stage(PgAioHandle *ioh, PgAioOp op)
 	RESUME_INTERRUPTS();
 }
 
+/*
+ * NEON: stage an IO whose work the caller performs itself.
+ *
+ * This is pgaio_io_stage() without the submission half. A network-backed smgr has
+ * no file descriptor to hand to an io worker, so its smgr_startreadv does the read
+ * inline and reports the outcome with pgaio_io_complete_external() below; the
+ * handle must still travel through the normal states so that the completion
+ * callbacks bufmgr registered run as usual.
+ *
+ * Interrupts are held from here until pgaio_io_complete_external(), exactly as
+ * they are across the body of pgaio_io_stage(), so the caller must pair the two.
+ */
+void
+pgaio_io_stage_external(PgAioHandle *ioh, PgAioOp op)
+{
+	Assert(ioh->state == PGAIO_HS_HANDED_OUT);
+	Assert(pgaio_my_backend->handed_out_io == ioh);
+	Assert(pgaio_io_has_target(ioh));
+
+	HOLD_INTERRUPTS();
+
+	ioh->op = op;
+	ioh->result = 0;
+
+	pgaio_io_update_state(ioh, PGAIO_HS_DEFINED);
+
+	/* allow a new IO to be staged */
+	pgaio_my_backend->handed_out_io = NULL;
+
+	pgaio_io_call_stage(ioh);
+
+	pgaio_io_update_state(ioh, PGAIO_HS_STAGED);
+}
+
+/*
+ * NEON: report the outcome of an IO staged with pgaio_io_stage_external().
+ *
+ * `result` reaches the completion callbacks unchanged, so its units are whatever
+ * they expect: bytes if PGAIO_HCB_MD_READV is registered, blocks if no
+ * smgr-level callback is. Releases the interrupt hold taken when staging.
+ */
+void
+pgaio_io_complete_external(PgAioHandle *ioh, int result)
+{
+	Assert(ioh->state == PGAIO_HS_STAGED);
+
+	pgaio_io_prepare_submit(ioh);
+
+	/* pgaio_io_process_completion() requires a critical section */
+	START_CRIT_SECTION();
+	pgaio_io_process_completion(ioh, result);
+	END_CRIT_SECTION();
+
+	RESUME_INTERRUPTS();
+}
+
 bool
 pgaio_io_needs_synchronous_execution(PgAioHandle *ioh)
 {
